{
    "type": "module",
    "devDependencies": {
        "@eslint/eslintrc": "^2.1.4",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-define-config": "^2.1.0",
        "eslint-plugin-vue": "^10.5.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2"
    },
    "scripts": {
        "prepare": "husky install"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "eslint --fix",
