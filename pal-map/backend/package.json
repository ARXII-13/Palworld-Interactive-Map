{
    "name": "backend",
    "version": "1.0.0",
    "main": "./build/server.js",
    "type": "module",
    "scripts": {
        "prebuild": "eslint . --ext .ts",
        "build": "tsc && npm run copy-assets && npm run rebuild:electron",
        "copy-assets": "npx copyfiles -u 2 src/assets/**/* build/assets",
        "rebuild:electron": "electron-rebuild -f -w better-sqlite3 --version 33.4.11",
        "dev": "npm run rebuild && nodemon --exec node --loader ts-node/esm src/server.ts",
        "rebuild": "npm rebuild better-sqlite3",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix"
    },
    "dependencies": {
        "better-sqlite3": "^12.4.1",
        "cors": "^2.8.5",
        "create-require": "^1.1.1",
        "express": "^4.21.2",
        "open": "^7.4.2",
        "winston": "^3.18.3"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.0"
    }
}
